		{"key": "testPassword", "value": "REPLACE_ME", "type": "string"},
		{"key": "adminEmail", "value": "admin@example.com", "type": "string"},
		{"key": "disease", "value": "Fusarium", "type": "string"},
		{"key": "language", "value": "tw", "type": "string"},
		{"key": "jwt", "value": "", "type": "string"}
	]
}
