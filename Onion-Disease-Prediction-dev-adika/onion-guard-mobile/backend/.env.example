MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=onionguard-secret-change-in-production

# LLM provider keys (used by diagnosis-service for /llm/freshness and /llm/translate)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=anthropic/claude-3-haiku

# Email (SMTP) — used by auth-service for password-reset emails
# For Gmail: enable 2FA + create an App Password at https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=OnionGuard
# Where Talk To Us submissions are delivered. Defaults to SMTP_USERNAME if blank.
FEEDBACK_RECIPIENT=

# OniQ IoT Gateway Ingestion Secret Key
GATEWAY_API_KEY=oniq-gateway-secret-key
